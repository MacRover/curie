<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="arm_ros2_control" params="name initial_positions_file use_mock_hardware">

        <xacro:property
            name="initial_positions"
            value="${load_yaml(initial_positions_file)['initial_positions']}"/>

        <ros2_control name="${name}" type="system">

            <hardware>
                <plugin>curie_arm_controller/CurieArmController</plugin>
                <param name="use_vcan">${use_mock_hardware}</param>

                <param name="lpf_sampling_frequency">50.0</param>
                <!-- placeholder for damping parameters -->
                <param name="lpf_damping_frequency">5.0</param>
                <param name="lpf_damping_intensity">0.0</param>

                <!-- <plugin>mock_components/GenericSystem</plugin> -->
            </hardware>

            <joint name="base_rotation">
                <command_interface name="position"/>
                <command_interface name="velocity"/>

                <state_interface name="position">
                    <param name="initial_value">${initial_positions['base_rotation']}</param>
                </state_interface>

                <state_interface name="velocity"/>
                <state_interface name="raw_position"/>
            </joint>

            <joint name="shoulder_joint">
                <command_interface name="position"/>
                <command_interface name="velocity"/>

                <state_interface name="position">
                    <param name="initial_value">${initial_positions['shoulder_joint']}</param>
                </state_interface>

                <state_interface name="velocity"/>
                <state_interface name="raw_position"/>
            </joint>

            <joint name="elbow_joint">
                <command_interface name="position"/>
                <command_interface name="velocity"/>

                <state_interface name="position">
                    <param name="initial_value">${initial_positions['elbow_joint']}</param>
                </state_interface>

                <state_interface name="velocity"/>
                <state_interface name="raw_position"/>
            </joint>

            <joint name="wrist_pitch">
                <command_interface name="position"/>
                <command_interface name="velocity"/>

                <state_interface name="position">
                    <param name="initial_value">${initial_positions['wrist_pitch']}</param>
                </state_interface>

                <state_interface name="velocity"/>
                <state_interface name="raw_position"/>
            </joint>

            <joint name="wrist_roll">
                <command_interface name="position"/>
                <command_interface name="velocity"/>

                <state_interface name="position">
                    <param name="initial_value">${initial_positions['wrist_roll']}</param>
                </state_interface>

                <state_interface name="velocity"/>
                <state_interface name="raw_position"/>
            </joint>

            <joint name="gripper">
                <command_interface name="position"/>

                <state_interface name="position">
                    <param name="initial_value">${initial_positions['gripper']}</param>
                </state_interface>

                <state_interface name="velocity"/>
                <state_interface name="raw_position"/>
            </joint>

        </ros2_control>

    </xacro:macro>

</robot>